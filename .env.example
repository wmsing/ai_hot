# 环境配置示例（复制为 .env；严禁提交真实密钥）
APP_ENV=development
LOG_LEVEL=INFO
# 预留：后续 Telegram 等推送密钥
API_KEY=
# OpenRouter（Grok/云端定时；香港可用；free 模型有日请求上限）
OPENROUTER_API_KEY=
# Threads Keyword Search（可选；需 Meta App + threads_keyword_search）
# THREADS_ACCESS_TOKEN=
# 覆盖 config.yaml 的 llm.provider：ollama | openrouter
# LLM_PROVIDER=openrouter
# 可选：覆盖默认 config.yaml 路径
# AI_HOT_CONFIG=/absolute/path/to/config.yaml
